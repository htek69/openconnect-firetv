# Task 1: native artifacts pinned from a known-good upstream CI build
# (see app/src/main/jniLibs/PROVENANCE.md for exact provenance). These are
# intentionally committed even though *.so and the arm64-v8a/, armeabi-v7a/, x86/,
# x86_64/ directory patterns above are ignored for locally-built output.
# (Ruling 8: jniLibs/armeabi/ was renamed to jniLibs/armeabi-v7a/ to resolve an
# ABI-directory collision with Compose's own armeabi-v7a native library; the
# assets/raw/armeabi/ path below deliberately keeps the upstream "armeabi" name
# because AssetExtractor.getArch() hardcodes that exact string.)
!/app/src/main/jniLibs/arm64-v8a/
!/app/src/main/jniLibs/arm64-v8a/*.so
!/app/src/main/jniLibs/armeabi-v7a/
!/app/src/main/jniLibs/armeabi-v7a/*.so
!/app/src/main/jniLibs/x86/
!/app/src/main/jniLibs/x86/*.so
!/app/src/main/jniLibs/x86_64/
!/app/src/main/jniLibs/x86_64/*.so
!/app/src/main/assets/raw/arm64-v8a/
!/app/src/main/assets/raw/arm64-v8a/curl-bin
!/app/src/main/assets/raw/armeabi/
!/app/src/main/assets/raw/armeabi/curl-bin
!/app/src/main/assets/raw/x86/
!/app/src/main/assets/raw/x86/curl-bin
!/app/src/main/assets/raw/x86_64/
!/app/src/main/assets/raw/x86_64/curl-bin

# 署名鍵とその設定（app/build.gradle が release.properties を読む）
release.properties
